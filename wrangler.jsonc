// Cloudflare Workers config. The Worker (worker/sites.js) serves dist/ (each release tag, built by tools/build-ui.mjs)
// at core.anawj.com/ui/*. No secrets in this file.
{
  "name": "app-ui",
  "main": "worker/sites.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // every request goes through the Worker first; it does the folder-index and trailing-slash handling itself, so
    // Cloudflare's own are off
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // no preview link per branch or build, and no *.workers.dev address: only the real address serves
  "preview_urls": false,
  "workers_dev": false,
  "keep_vars": true,
  // a route, not a custom domain: core.anawj.com itself is app-sync's Worker (its custom domain, /sync/ and /update/).
  // A route's Worker runs before the custom domain's, so /ui/ addresses come here and nothing else does.
  // core.anawj.com/kit and /kit/* redirect to the newest gallery (exact patterns: /kitchen is not ours)
  "routes": [
    { "pattern": "core.anawj.com/ui/*", "zone_name": "anawj.com" },
    { "pattern": "core.anawj.com/kit", "zone_name": "anawj.com" },
    { "pattern": "core.anawj.com/kit/*", "zone_name": "anawj.com" }
  ]
}
